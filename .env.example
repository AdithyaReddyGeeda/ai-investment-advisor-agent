# Required: Groq (Llama) for the agent
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI for embeddings (else uses HuggingFace local)
# OPENAI_API_KEY=your_openai_key

# Optional: News/sentiment (Alpha Vantage or NewsAPI)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# NEWS_API_KEY=your_newsapi_key

# Optional: Polygon for real-time data (else yfinance only)
# POLYGON_API_KEY=your_polygon_key

# Persistence
# PERSIST_DIR=./data/chroma
# CONVERSATION_DB=./data/conversations.db
